{
  "name": "bujhi",
  "version": "1.2.0",
  "private": true,
  "description": "Natural English ⇄ Bangla translation on any website.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "icons": "node scripts/icons.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true
  }
}
